NEXT_PUBLIC_SITE_URL=https://www.lotusrise.org

# Contact form endpoint. Inlined at build time. Leave empty and the form delivers through the
# visitor's email app (recipients in src/content/site-content.ts). When set, the form sends:
#   POST <endpoint>
#   Content-Type: application/json
#   {"name": "...", "email": "...", "organization": "...", "role": "...", "message": "..."}
# and treats any 2xx as success. The endpoint must allow CORS from the site origin, validate
# server-side, and rate-limit; the static site cannot do either.
NEXT_PUBLIC_CONTACT_ENDPOINT=
