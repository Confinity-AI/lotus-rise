{
  "name": "@lotus-rise/site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "npm run build:pages && gh-pages -d out --dotfiles --nojekyll -f",
    "start": "serve out",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome check --write src",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@once-ui-system/core": "1.8.2",
    "classnames": "2.5.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "sass": "1.102.0",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "1.63.0",
    "@types/node": "20.17.23",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "gh-pages": "6.3.0",
    "serve": "14.2.6",
    "typescript": "5.8.2"
  }
}
